# -----------------------------------------------------------------------------
# Environment variables for the portfolio contact form (src/app/api/contact)
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# On Vercel, set these in Project Settings → Environment Variables instead.
# -----------------------------------------------------------------------------

# Gmail address used to send and receive contact-form messages.
GMAIL_ACCOUNT=your-address@gmail.com

# Gmail App Password (16 characters) — NOT your normal account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_APP_PASSWORD=your-app-password
